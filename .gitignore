# Terraform: state is local by design (spec §4) and holds instance details.
terraform/.terraform/
*.tfstate
*.tfstate.*
terraform/cloud-init.rendered.yaml
# Generated by Terraform from the VM IPs.
ansible/inventory/hosts.yml
# Collections installed from ansible/requirements.yml.
ansible/collections/
# Generated passwords (Postgres, Grafana). Never committed.
.secrets/
.DS_Store
# Agent workspace (plans, reviews); never committed.
.superpowers/
