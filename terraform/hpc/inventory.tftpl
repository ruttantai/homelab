# Generated by Terraform from terraform/hpc/inventory.tftpl. Do not edit; `make hpc-infra` rewrites it.
all:
  vars:
    ansible_user: ops
    ansible_ssh_private_key_file: ${ssh_private_key}
  children:
    hpc:
      children:
        hpc_head:
          hosts:
%{ for name, ip in heads ~}
            ${name}:
              ansible_host: ${ip}
%{ endfor ~}
        hpc_compute:
          hosts:
%{ for name, ip in computes ~}
            ${name}:
              ansible_host: ${ip}
%{ endfor ~}
