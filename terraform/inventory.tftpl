# Generated by Terraform from terraform/inventory.tftpl. Do not edit; `make up` rewrites it.
all:
  vars:
    ansible_user: ops
    ansible_ssh_private_key_file: ${ssh_private_key}
  children:
    k3s_server:
      hosts:
%{ for name, ip in servers ~}
        ${name}:
          ansible_host: ${ip}
%{ endfor ~}
    k3s_agent:
      hosts:
%{ for name, ip in agents ~}
        ${name}:
          ansible_host: ${ip}
%{ endfor ~}
